# Configura estos valores en el panel de secretos del hosting. Nunca subas claves reales.
OPENAI_API_KEY=CONFIGURAR_SOLO_EN_EL_SERVIDOR
# ID no secreto del proyecto Firebase usado solo para verificar el inicio de sesión.
FIREBASE_PROJECT_ID=ID_DEL_PROYECTO_FIREBASE
OPENAI_MODEL=gpt-6-astra
PORT=8080
# Opcional: para clientes web; Android nativo normalmente no necesita CORS.
ALLOWED_ORIGIN=
