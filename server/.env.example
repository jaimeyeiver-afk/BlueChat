# Configura estas variables en el panel de tu servidor. No subas valores reales.
GEMINI_API_KEY=PEGA_LA_CLAVE_SOLO_EN_EL_SERVIDOR
# ID del proyecto Firebase (Firebase Console → Configuración del proyecto → "ID del proyecto").
# No es secreto, pero sin él el servidor rechaza todos los chats (503).
FIREBASE_PROJECT_ID=PEGA_EL_ID_DEL_PROYECTO_FIREBASE
GEMINI_MODEL=gemini-3.8-flash
PORT=8080
# Opcional: origen web permitido. Para app Android nativa normalmente no hace falta CORS.
ALLOWED_ORIGIN=
